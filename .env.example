# Copy to `.env` and fill in. `.env` is git-ignored; this file is the template
# and must never contain a real secret.

# Base URL of the Restaurant API, with no trailing slash.
# Simulator/emulator note: 127.0.0.1 points at the device, not your Mac.
#   iOS simulator      http://127.0.0.1:8000
#   Android emulator   http://10.0.2.2:8000
#   physical device    http://<your-lan-ip>:8000
API_BASE_URL=https://t-cafe-mobile-app-backend-fastapi-afbba65d.fastapicloud.dev

# Seconds. Applied to connect, send and receive separately.
API_TIMEOUT_SECONDS=20

# OAuth client id for Google sign-in. Leave blank to hide the Google button
# rather than shipping a button that cannot work.
GOOGLE_CLIENT_ID=

# Serves the customer's orders screen from memory instead of the API, for
# looking at it before the orders endpoints are live. Anything other than
# `true` — including absent — uses the real API.
USE_DEMO_ORDERS=false
